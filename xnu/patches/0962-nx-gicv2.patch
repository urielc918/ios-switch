From 2018454b89ec7c66686681b53b28d392c442a76c Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Thu, 5 Nov 2026 13:18:17 -0800
Subject: [PATCH 3/9] nx-0202: GICv2 (GIC-400) interrupt controller: MMIO init,
 IRQ ack/EOI, SGIs via GICD_SGIR

---
 iokit/Kernel/arm/SweetCPU.cpp |   6 ++
 osfmk/arm64/sleh.c            |  33 ++++++++++
 pexpert/arm/pe_fiq.c          | 109 +++++++++++++++++++++++++++++++++-
 pexpert/pexpert/arm/protos.h  |   6 ++
 4 files changed, 153 insertions(+), 1 deletion(-)

diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
index 96c557b..50c274e 100644
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -224,6 +224,11 @@ SweetCPU::signalCPU(IOCPU *target)
 	if (aff0 >= 16) {
 		panic("SWEET CPU: SGI target requires unsupported range selector");
 	}
+#if defined(NX_SWITCH)
+	/* GICv2: memory-mapped GICD_SGIR, CPU interface number = Aff0 on T210 */
+	nx_gic_send_sgi(1U << aff0, SWEET_IPI_SGI);
+	__builtin_arm_isb(ISB_SY);
+#else
 	uint64_t sgi = (((mpidr >> 32) & 0xff) << 48) |
 	    (((mpidr >> 16) & 0xff) << 32) |
 	    (((mpidr >> 8) & 0xff) << 16) |
@@ -231,6 +236,7 @@ SweetCPU::signalCPU(IOCPU *target)
 	__builtin_arm_dsb(DSB_ISHST);
 	__builtin_arm_wsr64("ICC_SGI1R_EL1", sgi);
 	__builtin_arm_isb(ISB_SY);
+#endif
 }
 
 kern_return_t
diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index a2a8c1b..a956ca0 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -1939,6 +1939,38 @@ sleh_irq(arm_saved_state_t *state)
 	 * sweet: TrustZone owns GIC Group 0, so the timer and IPIs that other
 	 * ARM64 targets take as FIQs arrive here as Group 1 IRQs.
 	 */
+#if defined(NX_SWITCH)
+	uint32_t iar = nx_gic_ack();
+	uint32_t intid = iar & 0x3FF;	/* GICv2: [12:10] = SGI source CPU */
+
+	if (intid >= 1020 && intid <= 1023) {
+		return; /* spurious */
+	}
+	if (intid == sweet_vtimer_intid) {
+		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_TIMER);
+		cdp->cpu_decrementer = -1; /* Large */
+		INTERRUPT_MASKED_DEBUG_START(rtclock_intr, DBG_INTR_TYPE_TIMER);
+		rtclock_intr(TRUE);
+		INTERRUPT_MASKED_DEBUG_END();
+		nx_gic_eoi(iar);
+	} else if (intid < 16) {
+		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_IPI);
+		/* Ack before handling so an IPI raised meanwhile is not lost */
+		nx_gic_eoi(iar);
+		__builtin_arm_isb(ISB_SY);
+		cpu_signal_handler();
+	} else {
+		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_OTHER);
+		if (cdp->interrupt_handler) {
+			cdp->interrupt_handler(cdp->interrupt_target,
+			    cdp->interrupt_refCon,
+			    cdp->interrupt_nub,
+			    intid);
+		}
+		nx_gic_eoi(iar);
+	}
+	__builtin_arm_isb(ISB_SY);
+#else
 	uint64_t iar = __builtin_arm_rsr64("ICC_IAR1_EL1");
 	uint32_t intid = (uint32_t)(iar & 0xFFFFFF);
 
@@ -1969,6 +2001,7 @@ sleh_irq(arm_saved_state_t *state)
 		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
 	}
 	__builtin_arm_isb(ISB_SY);
+#endif /* NX_SWITCH */
 #else
 	sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_OTHER);
 
diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 6089db9..14a71a2 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -11,7 +11,114 @@
 #include <machine/machine_routines.h>
 #include <pexpert/device_tree.h>
 #include <pexpert/arm64/board_config.h>
+#if NX_GIC_V2
+#include <pexpert/arm/protos.h>
+#endif
+
+
+#if NX_GIC_V2
+/*
+ * Nintendo Switch (Tegra X1): GIC-400, GICv2. The distributor and the CPU
+ * interface are memory-mapped; there are no ICC_* system registers. ATF
+ * leaves every interrupt in Group 1 (non-secure), so the timer and IPIs
+ * arrive as IRQs through sleh_irq(), as on the other SWEET boards.
+ */
+SECURITY_READ_ONLY_LATE(uint32_t) sweet_vtimer_intid = SWEET_VTIMER_INTID;
+
+static vm_offset_t nx_gicd_base;
+static vm_offset_t nx_gicc_base;
+
+static inline uint32_t
+nx_rd32(vm_offset_t addr)
+{
+	return *((volatile uint32_t *) addr);
+}
 
+static inline void
+nx_wr32(vm_offset_t addr, uint32_t value)
+{
+	*((volatile uint32_t *) addr) = value;
+}
+
+void
+pe_init_fiq()
+{
+	// Only the boot processor parses the DT (SecureDT* is not thread-safe).
+	if (!nx_gicd_base) {
+		DTEntry entry;
+		void const *prop;
+		unsigned int prop_size;
+
+		if (SecureDTLookupEntry(NULL, "/arm-io/gic", &entry) != kSuccess) {
+			panic("%s: cannot find GIC node in DT", __func__);
+		}
+		if (SecureDTGetProperty(entry, "reg", &prop, &prop_size) != kSuccess ||
+		    prop_size < 4 * sizeof(uint64_t)) {
+			panic("%s: GIC reg must be <GICD size GICC size>", __func__);
+		}
+		void const *timer_prop;
+		unsigned int timer_size;
+		if (SecureDTGetProperty(entry, "virtual-timer-intid", &timer_prop, &timer_size) == kSuccess) {
+			if (timer_size != sizeof(uint32_t)) {
+				panic("%s: invalid virtual-timer-intid size %u", __func__, timer_size);
+			}
+			uint32_t intid = *(const uint32_t *)timer_prop;
+			if (intid < 16 || intid >= 32) {
+				panic("%s: virtual timer INTID %u is not a PPI", __func__, intid);
+			}
+			sweet_vtimer_intid = intid;
+		}
+
+		vm_offset_t soc_base_phys = pe_arm_get_soc_base_phys();
+		uint64_t const *reg = (uint64_t const *)prop;
+		nx_gicc_base = ml_io_map(soc_base_phys + reg[2], reg[3]);
+		nx_gicd_base = ml_io_map(soc_base_phys + reg[0], reg[1]);
+		if (!nx_gicd_base || !nx_gicc_base) {
+			panic("%s: cannot map the GIC", __func__);
+		}
+		kprintf("NX GIC: GICv2 GICD 0x%llx GICC 0x%llx, virtual timer INTID %u\n",
+		    soc_base_phys + reg[0], soc_base_phys + reg[2], sweet_vtimer_intid);
+
+		// Distributor: forward Group 1 (the only group the non-secure side sees).
+		nx_wr32(nx_gicd_base + GICD_V2_CTLR, nx_rd32(nx_gicd_base + GICD_V2_CTLR) | 0x1);
+	}
+
+	// SGIs and PPIs are banked per CPU: set them up on every CPU.
+	for (unsigned int i = 0; i < 32; i += 4) {
+		nx_wr32(nx_gicd_base + GICD_V2_IPRIORITYR0 + i, 0xA0A0A0A0);
+	}
+	nx_wr32(nx_gicd_base + GICD_V2_ISENABLER0, (1U << sweet_vtimer_intid) | (1U << SWEET_IPI_SGI));
+
+	nx_wr32(nx_gicc_base + GICC_V2_PMR, 0xF0);
+	nx_wr32(nx_gicc_base + GICC_V2_BPR, 0);
+	nx_wr32(nx_gicc_base + GICC_V2_CTLR, 0x1);      // EnableGrp1, EOImode 0
+	__builtin_arm_dsb(DSB_SY);
+	__builtin_arm_isb(ISB_SY);
+}
+
+uint32_t
+nx_gic_ack(void)
+{
+	return nx_rd32(nx_gicc_base + GICC_V2_IAR);
+}
+
+void
+nx_gic_eoi(uint32_t iar)
+{
+	nx_wr32(nx_gicc_base + GICC_V2_EOIR, iar);
+}
+
+/*
+ * GICD_SGIR target list: one bit per CPU interface. On T210 the CPU
+ * interface number is the core's MPIDR Aff0 (one cluster, cores 0-3).
+ */
+void
+nx_gic_send_sgi(uint32_t cpu_mask, uint32_t sgi)
+{
+	__builtin_arm_dsb(DSB_ISHST);
+	nx_wr32(nx_gicd_base + GICD_V2_SGIR, ((cpu_mask & 0xFF) << 16) | (sgi & 0xF));
+}
+#endif /* NX_GIC_V2 */
 
 #if HAS_GIC_V3
 #define GICR_WAKE_TIMEOUT_NS (1000000000ULL) // timeout for redistributor wakeup (default 1s)
@@ -222,7 +329,7 @@ pe_init_fiq()
 	__builtin_arm_isb(ISB_SY);
 #endif /* SWEET */
 }
-#else
+#elif !NX_GIC_V2
 void
 pe_init_fiq()
 {
diff --git a/pexpert/pexpert/arm/protos.h b/pexpert/pexpert/arm/protos.h
index 9004f2b..b9c3202 100644
--- a/pexpert/pexpert/arm/protos.h
+++ b/pexpert/pexpert/arm/protos.h
@@ -39,6 +39,12 @@ void pe_init_fiq(void);
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 extern uint32_t sweet_vtimer_intid;
 #endif
+#if defined(NX_SWITCH)
+/* pexpert/arm/pe_fiq.c: GICv2 CPU interface and SGIs (Nintendo Switch) */
+uint32_t nx_gic_ack(void);
+void nx_gic_eoi(uint32_t iar);
+void nx_gic_send_sgi(uint32_t cpu_mask, uint32_t sgi);
+#endif
 
 #ifdef PRIVATE
 /**
-- 
2.55.0

