-nx_sdmmc_init(void)
+card_up(void)
 {
+	static bool tried;
 	DTEntry node;
 	uintptr_t const *reg = NULL;
 	unsigned int size = 0;
-	char want[40] = "ios";
-	uint32_t rw = 0;
-	int error;
 
+	if (tried) {
+		return sd.card_error;
+	}
+	tried = true;
 	if (SecureDTLookupEntry(NULL, "/nx-sdmmc", &node) != kSuccess ||
 	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
 	    size < 2 * sizeof(uintptr_t)) {
