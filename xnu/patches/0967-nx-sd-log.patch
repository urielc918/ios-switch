@@ -532,8 +549,8 @@ find_partition(const char *want, uint8_t *b)
 		memcpy(&first, e + 32, 8);
 		memcpy(&last, e + 40, 8);
 		if (strcmp(name, want) == 0 && last >= first) {
-			sd.first_block = first;
-			sd.nblocks = last - first + 1;
