 	sd.bmajor = bdevsw_add(-1, &nx_sdmmc_bdevsw);
 	if (sd.bmajor < 0) {
@@ -766,6 +814,149 @@ nx_sdmmc_init(void)
 	return 0;
 }
 
+/*
+ * Persistent console log on the "ioslog" partition (see the top of this
+ * file). A shadow of the ring is kept in memory with the same layout as on
+ * the card, so only the sectors that changed are written.
+ */
+#define LOG_RING        (4u << 20)              /* = SWEET_LOG_SIZE in sweet_ufs.c */
+#define LOG_HDR_SECTORS (4096u / SECTOR)        /* ring starts at +4096 (sweet-log.py) */
+
+static struct {
+	uint64_t first, count;                  /* partition, in sectors */
+	uint8_t *shadow;                        /* LOG_RING bytes */
+	uint8_t *hdr;                           /* one sector */
+	uint32_t secs;
+	int chan;
+} lg;
+
+struct nx_log_header {
+	char magic[8];
+	uint32_t version, size;
+	uint64_t total, seq;
+};
+
+/* Write ring bytes [a, b) (ring offsets, a < b) to the card. Lock held. */
+static int
+log_write_range(uint32_t a, uint32_t b)
+{
+	uint32_t s0 = a / SECTOR, s1 = (b + SECTOR - 1) / SECTOR;
+	while (s0 < s1) {
+		uint32_t n = MIN(s1 - s0, CHUNK_BLOCKS);
+		uint64_t lba = LOG_HDR_SECTORS + s0;
+		if (lba + n > lg.count) {               /* never outside the partition */
+			return EINVAL;
+		}
+		int error = sd_xfer(lg.first + lba, n, lg.shadow + (size_t)s0 * SECTOR, true);
+		if (error) {
+			return error;
+		}
+		s0 += n;
+	}
+	return 0;
+}
+
+static void
+nx_sdmmc_log_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t flushed = 0, seq = 0;
+	char *tmp = (char *)kalloc_data(16384, Z_WAITOK);
+	if (tmp == NULL) {
+		return;
+	}
+	printf("NX SD LOG: console log to partition at block 0x%llx, every %u s\n", lg.first, lg.secs);
+	for (;;) {
+		uint64_t total = sweet_log_position();
+		if (total != flushed) {
+			uint64_t pos = flushed, start = ~0ull;
+			uint32_t n;
+			while ((n = sweet_log_copy(&pos, tmp, 16384)) > 0) {
+				uint64_t at = pos - n;          /* sweet_log_copy may skip ahead */
+				if (start == ~0ull) {
+					start = at;
+				}
+				for (uint32_t i = 0; i < n; i++) {
+					lg.shadow[(at + i) % LOG_RING] = (uint8_t)tmp[i];
+				}
+			}
+			int error = 0;
+			lck_mtx_lock(&nx_sdmmc_lock);
+			if (start != ~0ull) {
+				if (pos - start >= LOG_RING) {
+					error = log_write_range(0, LOG_RING);
+				} else {
+					uint32_t a = (uint32_t)(start % LOG_RING), b = (uint32_t)(pos % LOG_RING);
+					if (a < b) {
+						error = log_write_range(a, b);
+					} else {
+						error = log_write_range(a, LOG_RING);
+						if (!error && b) {
+							error = log_write_range(0, b);
+						}
+					}
+				}
+			}
+			if (!error) {
+				struct nx_log_header h = {
+					.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+					.version = 1, .size = LOG_RING, .total = pos, .seq = ++seq,
+				};
+				bzero(lg.hdr, SECTOR);
+				memcpy(lg.hdr, &h, sizeof(h));
+				error = sd_xfer(lg.first, 1, lg.hdr, true);
+			}
+			lck_mtx_unlock(&nx_sdmmc_lock);
+			if (error) {
+				printf("NX SD LOG: write failed (%d), stopping\n", error);
+				kfree_data(tmp, 16384);
+				return;
+			}
+			flushed = pos;
+		}
+		(void)tsleep(&lg.chan, PZERO, "nxsdlog", hz * (int)lg.secs);
+	}
+}
+
+/* Boot-arg sdlog=1: start the log writer (IOFindBSDRoot calls this once). */
+void
+nx_sdmmc_log_start(void)
+{
+	static bool started;
+	uint32_t on = 0;
+	char want[40] = "ioslog";
+	thread_t thread;
+
+	if (started || !PE_parse_boot_argn("sdlog", &on, sizeof(on)) || on != 1) {
+		return;
+	}
+	started = true;
+	PE_parse_boot_argn("sdlogpart", want, sizeof(want));
+	lg.secs = 2;
+	PE_parse_boot_argn("sdlogsecs", &lg.secs, sizeof(lg.secs));
+	if (lg.secs == 0 || lg.secs > 60) {
+		lg.secs = 2;
+	}
+	lck_mtx_lock(&nx_sdmmc_lock);
+	int error = lookup(want, &lg.first, &lg.count);
+	lck_mtx_unlock(&nx_sdmmc_lock);
+	if (error) {
+		return;
+	}
+	if (lg.count < LOG_HDR_SECTORS + LOG_RING / SECTOR) {
+		printf("NX SD LOG: partition \"%s\" too small (%llu sectors)\n", want, lg.count);
+		return;
+	}
+	lg.shadow = (uint8_t *)kalloc_data(LOG_RING, Z_WAITOK | Z_ZERO);
+	lg.hdr = (uint8_t *)kalloc_data(SECTOR, Z_WAITOK | Z_ZERO);
+	if (lg.shadow == NULL || lg.hdr == NULL) {
+		printf("NX SD LOG: no memory\n");
+		return;
+	}
+	if (kernel_thread_start(nx_sdmmc_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
 /* Root device for rd=sdroot0 (IOFindBSDRoot). */
 int
 nx_sdmmc_rootdev(dev_t *dev)
@@ -788,4 +979,9 @@ nx_sdmmc_rootdev(__unused dev_t *dev)
 	return ENXIO;
 }
 
+void
+nx_sdmmc_log_start(void)
+{
+}
