+/* Find a partition by name (or mbr:N) and check it lies on the card. Lock held. */
+static int
+lookup(const char *want, uint64_t *first, uint64_t *count)
+{
 	uint8_t *b = (uint8_t *)kalloc_data(SECTOR, Z_WAITOK | Z_ZERO);
 	if (b == NULL) {
 		return ENOMEM;
 	}
-	lck_mtx_lock(&nx_sdmmc_lock);
-	error = host_init();
-	if (!error) {
-		error = card_init();
-	}
+	int error = card_up();
 	if (!error) {
-		printf("NX SD: %s card, %llu MiB, RCA 0x%x\n", sd.sdhc ? "SDHC/SDXC" : "SDSC",
-		    sd.card_blocks >> 11, sd.rca);
-		error = find_partition(want, b);
+		error = find_partition(want, b, first, count);
 	}
-	lck_mtx_unlock(&nx_sdmmc_lock);
 	kfree_data(b, SECTOR);
+	if (!error && (*count == 0 || *first + *count > sd.card_blocks)) {
