From 9009842959ba874c9b5d1ce090c70cbe129cb593 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Thu, 5 Nov 2026 21:59:32 -0800
Subject: [PATCH] nx-0970: AppleCLCD on the Switch: copy-path presentation into
 the shim framebuffer (720x1280 shown of a 750x1334 iPhone 8 screen), no
 Qualcomm MDP/DSI/GPU

---
 iokit/Kernel/arm/SweetFramebuffer.cpp | 35 ++++++++++++++++++++-------
 1 file changed, 26 insertions(+), 9 deletions(-)

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 937963d..a30c47a 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -131,7 +131,11 @@ enum {
 #define SWEET_FB_NOTIFY_TYPES           8
 #define SWEET_FB_NOTIFY_VSYNC           5
 #define SWEET_FB_VSYNC_US               16667
+#if defined(NX_SWITCH)
+#define SWEET_FB_DOT_PITCH              326     /* ppi, as the iPhone 8 panel */
+#else
 #define SWEET_FB_DOT_PITCH              458     /* ppi, as the iPhone X panel */
+#endif
 /*
  * The iOS userland only has status bar / layout data for real iPhone
  * screens (UIKit: "No status bar visual provider for screen", the red
@@ -140,8 +144,18 @@ enum {
  * centered 1080x2400 part of it is shown on the 1080x2400 panel.
  * Boot-arg sweetfb_native=1 presents the real panel size instead.
  */
+#if defined(NX_SWITCH)
+/*
+ * Nintendo Switch: the 720x1280 panel is presented as the iPhone 8 screen,
+ * 750x1334 (375x667 points @2x, tools/mkadt-nx.py), and the centered
+ * 720x1280 part of it is shown.
+ */
+#define SWEET_FB_LOGICAL_W              750
+#define SWEET_FB_LOGICAL_H              1334
+#else
 #define SWEET_FB_LOGICAL_W              1125
 #define SWEET_FB_LOGICAL_H              2436
+#endif
 #define SWEET_FB_FORMAT_BGRA            0x42475241
 
 class IOMobileFramebuffer : public IOService {
@@ -314,21 +328,21 @@ AppleCLCD::start(IOService *provider)
 	}
 #if defined(NX_SWITCH)
 	/*
-	 * Nintendo Switch: the rest of this driver programs the Qualcomm MDP/DSI
-	 * and starts topaz's modem, audio and Adreno drivers. Keep only the
-	 * services userland needs (AMFI); the kernel text console stays on the
-	 * shim framebuffer (/sweet-fbcon). A Tegra DC driver comes later.
+	 * Nintendo Switch: no Qualcomm MDP/DSI, modem, audio or Adreno. The shim
+	 * left display controller A scanning out the boot framebuffer (window A,
+	 * 720x1280 B8G8R8A8 at 0xF0000000), so frames are presented by the copy
+	 * path (present(): every layer composed into fPixels, write-combined),
+	 * paced by the vsync timer. fVig0/fCtl0/fDsi/fIntf1 stay NULL: no direct
+	 * scanout, no panel brightness or power commands.
 	 */
 	sweet_amfi_service_init();
 	sweet_busy_init();
-	(void)video;
-	IOLog("NX FB: no display driver yet (text console only)\n");
-	return false;
 #else
 	topaz_modem_init();
 	topaz_audio_init();
 	sweet_amfi_service_init();
 	sweet_busy_init();
+#endif
 	PE_current_console(&video);
 	fPhys = video.v_baseAddr;
 	fWidth = (uint32_t)video.v_width;
@@ -365,6 +379,7 @@ AppleCLCD::start(IOService *provider)
 		IOLog("SWEET FB: no vsync timer\n");
 		return false;
 	}
+#if !defined(NX_SWITCH)
 	fVig0 = (volatile uint32_t *)ml_io_map(0x05e05000, 0x1000);
 	fCtl0 = (volatile uint32_t *)ml_io_map(0x05e02000, 0x1000);
 	topaz_adreno_init();
@@ -400,6 +415,7 @@ AppleCLCD::start(IOService *provider)
 		}
 		OSSafeReleaseNULL(bl);
 	}
+#endif /* !NX_SWITCH */
 	uint32_t accelOn = 1;
 	(void)PE_parse_boot_argn("sweetaccel", &accelOn, sizeof(accelOn));
 	IOAcceleratorES *accel = accelOn ? OSTypeAlloc(IOAcceleratorES) : NULL;
@@ -411,6 +427,7 @@ AppleCLCD::start(IOService *provider)
 		}
 	}
 	OSSafeReleaseNULL(accel);
+#if !defined(NX_SWITCH)
 	/* dpu sm6115 catalog: intf_1 at mdp+0x6a800, mdp at 0x5e01000 */
 	fIntf1 = (volatile uint32_t *)ml_io_map(0x05e6b000, 0x1000);
 	if (fIntf1 != NULL) {
@@ -460,6 +477,7 @@ AppleCLCD::start(IOService *provider)
 			OSSafeReleaseNULL(fCons);
 		}
 	}
+#endif /* !NX_SWITCH */
 	uint32_t hz = 10;
 	PE_parse_boot_argn("sweetfb_hz", &hz, sizeof(hz));
 	fFlushTicks = (hz == 0 || hz >= 60) ? 1 : 60 / hz;
@@ -488,7 +506,6 @@ AppleCLCD::start(IOService *provider)
 	IOLog("SWEET FB: AppleCLCD %ux%u stride %u at 0x%llx, default surface %u, presented as %ux%u\n",
 	    fWidth, fHeight, fRowBytes, fPhys, fSurface->id, fLogicalW, fLogicalH);
 	return true;
-#endif /* NX_SWITCH */
 }
 
 void
@@ -917,7 +934,7 @@ AppleCLCD::showDirect(const uint8_t *rec, SweetSurface **heldIn)
 		sweet_hold_set(dropped, false);
 		uint64_t waited = mach_absolute_time(), wns = 0;  /* (present waits for the GPU too) */
 		present(rec);
-		for (int t = 0; t < 250 && (fCtl0[0x18 / 4] & 0x20001) != 0; t++) {
+		for (int t = 0; fCtl0 != NULL && t < 250 && (fCtl0[0x18 / 4] & 0x20001) != 0; t++) {
 			IODelay(100);                           /* until the MDP has latched it */
 		}
 		absolutetime_to_nanoseconds(mach_absolute_time() - waited, &wns);
-- 
2.55.0

