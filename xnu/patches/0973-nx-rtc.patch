From eb36cee48ca5f39d39ca93f79d1bb402922c7dcf Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Fri, 6 Nov 2026 00:08:26 -0800
Subject: [PATCH] nx-0973: MAX77620 RTC as wall clock (read-only, boot-arg
 nxtimeoff), IORTC published (no 30 s boot wait), touch 180-degree mapping as
 default

---
 bsd/dev/nx_input.c                       | 78 +++++++++++++++++++++++-
 iokit/Kernel/arm/SweetPlatformExpert.cpp | 41 +++++++++++++
 2 files changed, 116 insertions(+), 3 deletions(-)

diff --git a/bsd/dev/nx_input.c b/bsd/dev/nx_input.c
index f5345de..8559c46 100644
--- a/bsd/dev/nx_input.c
+++ b/bsd/dev/nx_input.c
@@ -14,8 +14,8 @@
  * Touchscreen: STM FTS4 on I2C3, address 0x49, powered up and identified by
  * shim-nx (touch.c: reset GPIO J7, LDO6, I2C3 clock). Here: system reset,
  * finger sensing on, then the event stack is read every 10 ms. Coordinates
- * come in landscape (x along the long side); like hekate's Nyx (VIC rotation
- * 270) they map to the portrait 720x1280 panel as fb x = 719 - y, fb y = x.
+ * come in landscape (x along the long side) and map to the portrait 720x1280
+ * panel as fb x = y, fb y = 1279 - x (measured on hardware; see fts_map).
  * Boot-args: nxtouch=0 disables it, nxtouchrot=N corrects the mapping
  * (1 flip x, 2 flip y, 4 swap x/y, applied after the default).
  */
@@ -25,6 +25,7 @@
 
 void nx_input_start(void);
 int nx_i2c_xfer(unsigned bus, uint8_t addr, const uint8_t *wr, unsigned wlen, uint8_t *rd, unsigned rlen);
+int nx_rtc_read(uint64_t *epoch);
 
 #if defined(NX_SWITCH)
 #include <sys/systm.h>
@@ -150,6 +151,9 @@ nx_i2c_xfer(unsigned bus, uint8_t addr, const uint8_t *wr, unsigned wlen, uint8_
 	uint8_t tmp[8];
 	int error = 0;
 
+	if (i2c_base == 0) {
+		i2c_base = ml_io_map(I2C_PA, 0x2000);   /* first use may come before nx_input_start (RTC) */
+	}
 	if (i2c_base == 0 || bus < 1 || bus > 6 || wlen > 8 || rlen > 8) {
 		return EINVAL;
 	}
@@ -292,7 +296,12 @@ fts_map(uint32_t rx, uint32_t ry, int *px, int *py)
 	if (ty > 719) {
 		ty = 719;
 	}
-	int x = 719 - (int)ty, y = (int)tx;
+	/*
+	 * Nyx's mapping (VIC rotation 270: fb x = 719 - ty, fb y = tx) turned
+	 * out rotated 180 degrees on the Switch: a top-right tap arrived bottom
+	 * left. So: fb x = ty, fb y = 1279 - tx. nxtouchrot corrects further.
+	 */
+	int x = (int)ty, y = 1279 - (int)tx;
 	if (touch_rot & 4) {                                    /* swap, scaled to the other axis */
 		int nx = y * 720 / 1280, ny = x * 1280 / 720;
 		x = nx;
@@ -420,6 +429,63 @@ keys_thread(__unused void *arg, __unused wait_result_t wr)
 	}
 }
 
+/*
+ * MAX77620 real-time clock (I2C5, address 0x68), read-only: Horizon owns it.
+ * UPDATE0 (0x04) bit 4 copies the clock into the read registers; CONTROL
+ * (0x03) bit 1 = 24-hour mode; sec 0x07, min 0x08, hour 0x09 (bit 6 PM in
+ * 12-hour mode), month 0x0B (1-12), year 0x0C (+2000), day 0x0D, binary.
+ * Returns seconds since 1970 as the chip counts them (no offset).
+ */
+#define RTC_ADDR        0x68
+
+static int
+rtc_reg(uint8_t reg, uint8_t *val)
+{
+	return nx_i2c_xfer(5, RTC_ADDR, &reg, 1, val, 1);
+}
+
+/* Days since 1970-01-01 of a proleptic Gregorian date (Howard Hinnant's algorithm). */
+static int64_t
+days_from_civil(int64_t y, unsigned m, unsigned d)
+{
+	y -= m <= 2;
+	int64_t era = (y >= 0 ? y : y - 399) / 400;
+	unsigned yoe = (unsigned)(y - era * 400);
+	unsigned doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
+	unsigned doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+	return era * 146097 + (int64_t)doe - 719468;
+}
+
+int
+nx_rtc_read(uint64_t *epoch)
+{
+	uint8_t upd[2] = { 0x04, 0x10 };
+	uint8_t ctl, sec, min, hour, mon, year, day;
+	int error = nx_i2c_xfer(5, RTC_ADDR, upd, 2, NULL, 0);
+	if (!error) {
+		delay(20000);                   /* read buffer update (16 ms at the 32 kHz clock) */
+		error = rtc_reg(0x03, &ctl) || rtc_reg(0x07, &sec) || rtc_reg(0x08, &min) ||
+		    rtc_reg(0x09, &hour) || rtc_reg(0x0B, &mon) || rtc_reg(0x0C, &year) ||
+		    rtc_reg(0x0D, &day) ? EIO : 0;
+	}
+	if (error) {
+		return error;
+	}
+	unsigned h = hour & 0x1F;
+	if (!(ctl & 0x02)) {                    /* 12-hour mode */
+		h = (hour & 0x0F) % 12 + ((hour & 0x40) ? 12 : 0);
+	}
+	unsigned m = mon & 0x0F, d = day & 0x1F;
+	if (m < 1 || m > 12 || d < 1 || d > 31 || h > 23 || (sec & 0x7F) > 59 || (min & 0x7F) > 59) {
+		return EINVAL;
+	}
+	int64_t days = days_from_civil(2000 + (year & 0x7F), m, d);
+	*epoch = (uint64_t)(days * 86400 + h * 3600 + (min & 0x7F) * 60 + (sec & 0x7F));
+	printf("NX RTC: 20%02u-%02u-%02u %02u:%02u:%02u (raw ctl %#x hour %#x) = %llu\n",
+	    year & 0x7F, m, d, h, min & 0x7F, sec & 0x7F, ctl, hour, *epoch);
+	return 0;
+}
+
 /* Called once from IOFindBSDRoot (iokit/bsddev/IOKitBSDInit.cpp). */
 void
 nx_input_start(void)
@@ -485,4 +551,10 @@ nx_i2c_xfer(__unused unsigned bus, __unused uint8_t addr, __unused const uint8_t
 	return ENXIO;
 }
 
+int
+nx_rtc_read(__unused uint64_t *epoch)
+{
+	return ENXIO;
+}
+
 #endif /* NX_SWITCH */
diff --git a/iokit/Kernel/arm/SweetPlatformExpert.cpp b/iokit/Kernel/arm/SweetPlatformExpert.cpp
index 0631685..0d5135c 100644
--- a/iokit/Kernel/arm/SweetPlatformExpert.cpp
+++ b/iokit/Kernel/arm/SweetPlatformExpert.cpp
@@ -18,6 +18,10 @@ public:
 	void processTopLevel(IORegistryEntry *root) APPLE_KEXT_OVERRIDE;
 	const char *deleteList(void) APPLE_KEXT_OVERRIDE;
 	const char *excludeList(void) APPLE_KEXT_OVERRIDE;
+#if defined(NX_SWITCH)
+	long getGMTTimeOfDay(void) APPLE_KEXT_OVERRIDE;
+	void setGMTTimeOfDay(long secs) APPLE_KEXT_OVERRIDE;
+#endif
 };
 
 OSDefineMetaClassAndStructors(SweetPlatformExpert, IODTPlatformExpert);
@@ -31,9 +35,46 @@ SweetPlatformExpert::start(IOService *provider)
 	}
 	registerService();
 	IOLog("SWEET: platform expert registered\n");
+#if defined(NX_SWITCH)
+	/*
+	 * IOKitInitializeTime waits up to 30 s for an "IORTC" resource before it
+	 * reads the time (getGMTTimeOfDay below, from the MAX77620): publish it.
+	 */
+	publishResource("IORTC", kOSBooleanTrue);
+#endif
 	return true;
 }
 
+#if defined(NX_SWITCH)
+extern "C" int nx_rtc_read(uint64_t *epoch);    /* bsd/dev/nx_input.c */
+
+/*
+ * Nintendo Switch: the MAX77620 RTC as the chip counts it, plus boot-arg
+ * nxtimeoff (signed seconds) to make it UTC: Horizon doesn't keep the RTC on
+ * UTC (hekate shows it with its own "timeoffset" from nyx.ini).
+ */
+long
+SweetPlatformExpert::getGMTTimeOfDay(void)
+{
+	uint64_t epoch = 0;
+	int64_t off = 0;
+	if (nx_rtc_read(&epoch) != 0) {
+		IOLog("NX RTC: read failed\n");
+		return 0;
+	}
+	(void)PE_parse_boot_argn("nxtimeoff", &off, sizeof(off));
+	IOLog("NX RTC: offset %lld s -> %lld\n", off, (int64_t)epoch + off);
+	return (long)((int64_t)epoch + off);
+}
+
+/* The RTC belongs to Horizon: never written from here. */
+void
+SweetPlatformExpert::setGMTTimeOfDay(long secs)
+{
+	IOLog("NX RTC: not setting the RTC (%ld)\n", secs);
+}
+#endif
+
 const char *
 SweetPlatformExpert::deleteList(void)
 {
-- 
