From 2f22afc12eb25aa1a072fc72cff3edd86b3accd0 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Fri, 6 Nov 2026 11:40:47 -0800
Subject: [PATCH] nx-0975: SD high speed (CMD6, 48 MHz, verified by a re-read,
 boot-arg sdhs=0 to skip), boot-arg sdbench=N read benchmark

---
 bsd/dev/nx_sdmmc.c | 170 +++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 166 insertions(+), 4 deletions(-)

diff --git a/bsd/dev/nx_sdmmc.c b/bsd/dev/nx_sdmmc.c
index 63ab28a..7aa29ef 100644
--- a/bsd/dev/nx_sdmmc.c
+++ b/bsd/dev/nx_sdmmc.c
@@ -6,7 +6,8 @@
  * up again (pads, MAX77620 LDO2, PMC IO power, CAR module and timeout
  * clocks; see shim-nx/sdmmc.c and NOTES.md). This driver takes the
  * controller from there: software reset, Tegra trims and pad calibration,
- * card identification, 4-bit bus at 24.7 MHz, then polled PIO (no DMA, so
+ * card identification, 4-bit bus at 24.7 MHz, then SD high speed (CMD6,
+ * 48 MHz; boot-arg sdhs=0 keeps default speed), then polled PIO (no DMA, so
  * no cache maintenance). It finds one partition (boot-arg sdroot=: a GPT
  * partition name, default "ios", or "mbr:N" for MBR slot N, 1-4) and
  * exposes it as the BSD disk sdroot0 (rsdroot0), 512-byte sectors. Root on
@@ -84,6 +85,7 @@ extern void (*nx_panic_log_hook)(const char *fmt, va_list *args);
 #define  PS_DAT_INHIBIT (1u << 1)
 #define SD_HOSTCTL      0x28    /* 8 */
 #define  HC_4BIT        (1u << 1)
+#define  HC_HISPD       (1u << 2)
 #define SD_PWRCON       0x29    /* 8 */
 #define  PWR_ON         (1u << 0)
 #define  PWR_330        (7u << 1)
@@ -121,6 +123,16 @@ extern void (*nx_panic_log_hook)(const char *fmt, va_list *args);
 #define  AUTOCAL_ACTIVE (1u << 31)
 #define SD_IOSPARE      0x1F0
 
+/* CAR: SDMMC1 module clock (source 0 = PLLP 408 MHz, 7.1 divider: 408 / (1 + div / 2)) */
+#define CAR_PA                  0x60006000u
+#define CAR_RST_DEV_L           0x004u
+#define CAR_CLK_SOURCE_SDMMC1   0x150u
+#define CAR_CLK_ENB_L_SET       0x320u
+#define CAR_CLK_ENB_L_CLR       0x324u
+#define  CAR_L_SDMMC1           (1u << 14)
+#define  SDMMC1_DIV_DS          31u     /* 24.7 MHz, set by shim-nx */
+#define  SDMMC1_DIV_HS          15u     /* 48 MHz, hekate's SD HS25 */
+
 #define SECTOR          512u
 #define CHUNK_BLOCKS    2048u           /* blocks per multi-block command (1 MiB) */
 #define CMD_TIMEOUT_US  100000u
@@ -140,6 +152,7 @@ static struct {
 	dev_t bdev;
 	bool ready;
 	uint32_t last_err;              /* INTSTS of the last failure */
+	uint32_t mhz10;                 /* card clock in 0.1 MHz, for the log */
 } sd;
 
 static LCK_GRP_DECLARE(nx_sdmmc_grp, "nx_sdmmc");
@@ -219,6 +232,9 @@ wait_int(uint32_t want, uint32_t timeout_us)
 	}
 }
 
+/* Block size of the next data command if not 0 (else SECTOR); see sd_read_short. */
+static uint32_t sd_blksize;
+
 /*
  * One command. data: 0 none, 1 read, 2 write; nblk > 1 uses the block
  * count register and auto CMD12. Returns with the response in resp.
@@ -249,7 +265,7 @@ sd_cmd(uint32_t idx, uint32_t arg, uint32_t rsp, int data, uint32_t nblk, uint32
 	wr32(SD_ARG, arg);
 	uint32_t trn = 0;
 	if (data) {
-		wr16(SD_BLKSIZE, SECTOR);
+		wr16(SD_BLKSIZE, (uint16_t)(sd_blksize ? sd_blksize : SECTOR));
 		wr16(SD_BLKCNT, (uint16_t)nblk);
 		trn = (data == 1 ? TRN_READ : 0);
 		if (nblk > 1) {
@@ -397,6 +413,111 @@ csd_blocks(const uint32_t *r)
 #undef CSD_BITS
 }
 
+/* One short data block (len bytes, multiple of 4, <= 512) from a read command such as CMD6. */
+static int
+sd_read_short(uint32_t idx, uint32_t arg, uint8_t *buf, uint32_t len)
+{
+	uint32_t r = 0;
+	sd_blksize = len;
+	int error = sd_cmd(idx, arg, RSP_48, 1, 1, &r);
+	sd_blksize = 0;
+	if (!error) {
+		error = wait_int(INT_BUF_RD, DATA_TIMEOUT_US);
+	}
+	if (!error) {
+		wr32(SD_INTSTS, INT_BUF_RD);
+		for (uint32_t i = 0; i < len; i += 4) {
+			uint32_t w = rd32(SD_BUFFER);
+			memcpy(buf + i, &w, 4);
+		}
+		error = wait_int(INT_XFER_DONE, DATA_TIMEOUT_US);
+		wr32(SD_INTSTS, INT_XFER_DONE);
+	}
+	if (error) {
+		reset_lines(RST_CMD | RST_DAT);
+	}
+	return error;
+}
+
+static void
+set_module_clock(unsigned div)
+{
+	static vm_offset_t car;
+	if (car == 0) {
+		car = ml_io_map(CAR_PA, 0x1000);
+	}
+	if (car == 0) {
+		return;
+	}
+	/* As hekate's clock_sdmmc_config_clock_source: gate, set, ungate, commit. */
+	wr16(SD_CLKCON, (uint16_t)(rd16(SD_CLKCON) & ~CLK_CARD_EN));
+	*(volatile uint32_t *)(car + CAR_CLK_ENB_L_CLR) = CAR_L_SDMMC1;
+	*(volatile uint32_t *)(car + CAR_CLK_SOURCE_SDMMC1) = (0u << 29) | div;
+	(void)*(volatile uint32_t *)(car + CAR_CLK_SOURCE_SDMMC1);
+	*(volatile uint32_t *)(car + CAR_CLK_ENB_L_SET) = CAR_L_SDMMC1;
+	(void)*(volatile uint32_t *)(car + CAR_RST_DEV_L);
+	delay(10);
+	uint64_t t = now_us();
+	while (!(rd16(SD_CLKCON) & CLK_INT_STABLE) && now_us() - t < CMD_TIMEOUT_US) {
+	}
+}
+
+/*
+ * SD high speed (function group 1, function 1), as hekate's
+ * _sd_storage_set_hs25_bus_speed: CMD6 check, CMD6 switch, then the host's
+ * high-speed bit and the 48 MHz module clock (tap value unchanged). The
+ * 64-byte switch status is MSB first: byte 13 bit 1 = function 1 supported,
+ * byte 16 low nibble = function selected in group 1 (0xF = error).
+ * Returns 0 with the card in high speed, else the card stays at default speed.
+ */
+static int sd_xfer_raw(uint64_t lba, uint32_t n, uint8_t *buf, bool write);
+static uint8_t hs_ref[SECTOR], hs_chk[SECTOR];
+
+static int
+card_high_speed(void)
+{
+	uint8_t st[64];
+	int error;
+
+	/* Reference data at default speed: the GPT header sector. */
+	if ((error = sd_xfer_raw(1, 1, hs_ref, false))) {
+		return error;
+	}
+
+	if ((error = sd_read_short(6, 0x00FFFFF1, st, sizeof(st)))) {
+		printf("NX SD: CMD6 check failed %d (intsts 0x%08x)\n", error, sd.last_err);
+		return error;
+	}
+	if (!(st[13] & 0x02) || (st[16] & 0xF) != 1) {
+		printf("NX SD: no high speed (support %#x, group 1 %#x)\n", st[13], st[16] & 0xF);
+		return ENOTSUP;
+	}
+	if ((error = sd_read_short(6, 0x80FFFFF1, st, sizeof(st)))) {
+		printf("NX SD: CMD6 switch failed %d (intsts 0x%08x)\n", error, sd.last_err);
+		return error;
+	}
+	if ((st[16] & 0xF) != 1) {
+		printf("NX SD: CMD6 switch: group 1 = %#x\n", st[16] & 0xF);
+		return EIO;
+	}
+	delay(1000);                    /* the switch takes effect within 8 clocks */
+	wr8(SD_HOSTCTL, (uint8_t)(rd8(SD_HOSTCTL) | HC_HISPD));
+	set_module_clock(SDMMC1_DIV_HS);
+	set_card_clock(1);
+	if (!(error = wait_ready()) && !(error = sd_xfer_raw(1, 1, hs_chk, false)) &&
+	    memcmp(hs_ref, hs_chk, SECTOR) != 0) {
+		error = EIO;
+	}
+	if (error) {
+		printf("NX SD: 48 MHz check failed (%d), back to 24.7 MHz\n", error);
+		wr8(SD_HOSTCTL, (uint8_t)(rd8(SD_HOSTCTL) & ~HC_HISPD));
+		set_module_clock(SDMMC1_DIV_DS);
+		set_card_clock(1);
+		return error;
+	}
+	return 0;
+}
+
 static int
 card_init(void)
 {
@@ -447,9 +568,16 @@ card_init(void)
 	if (!sd.sdhc && (error = sd_cmd(16, SECTOR, RSP_48, 0, 0, r))) {
 		return error;
 	}
+	uint32_t hs = 1;
+	(void)PE_parse_boot_argn("sdhs", &hs, sizeof(hs));
+	sd.mhz10 = 247;
+	if (hs && card_high_speed() == 0) {
+		sd.mhz10 = 480;
+	}
 	return 0;
 }
 
+
 /*
  * A panic flushes the console log from whatever CPU panics, without the lock
  * (another CPU may hold it, or be in the middle of a transfer): sd_active says
@@ -779,8 +907,9 @@ card_up(void)
 		printf("NX SD: card init failed: %d (intsts 0x%08x)\n", error, sd.last_err);
 	} else {
 		sd.card_ok = true;
-		printf("NX SD: %s card, %llu MiB, RCA 0x%x\n", sd.sdhc ? "SDHC/SDXC" : "SDSC",
-		    sd.card_blocks >> 11, sd.rca);
+		printf("NX SD: %s card, %llu MiB, RCA 0x%x, %s %u.%u MHz\n", sd.sdhc ? "SDHC/SDXC" : "SDSC",
+		    sd.card_blocks >> 11, sd.rca, sd.mhz10 > 247 ? "high speed" : "default speed",
+		    sd.mhz10 / 10, sd.mhz10 % 10);
 	}
 	sd.card_error = error;
 	return error;
@@ -808,6 +937,38 @@ lookup(const char *want, uint64_t *first, uint64_t *count)
 	return error;
 }
 
+/*
+ * Boot-arg sdbench=N: time N MiB of reads from the start of the partition
+ * (1 MiB commands, as the strategy routine issues them) and log MB/s.
+ */
+static void
+sd_bench(void)
+{
+	uint32_t mib = 0;
+	if (!PE_parse_boot_argn("sdbench", &mib, sizeof(mib)) || mib == 0) {
+		return;
+	}
+	mib = MIN(mib, 64u);
+	uint8_t *b = (uint8_t *)kalloc_data(CHUNK_BLOCKS * SECTOR, Z_WAITOK);
+	if (b == NULL) {
+		return;
+	}
+	uint64_t n = MIN((uint64_t)mib * 2048, sd.nblocks), done = 0;
+	int error = 0;
+	uint64_t t = now_us();
+	lck_mtx_lock(&nx_sdmmc_lock);
+	while (!error && done < n) {
+		uint32_t c = (uint32_t)MIN(n - done, (uint64_t)CHUNK_BLOCKS);
+		error = sd_xfer(sd.first_block + done, c, b, false);
+		done += c;
+	}
+	lck_mtx_unlock(&nx_sdmmc_lock);
+	t = now_us() - t;
+	kfree_data(b, CHUNK_BLOCKS * SECTOR);
+	printf("NX SD: bench %llu KiB in %llu ms = %llu KB/s at %u.%u MHz (err %d)\n",
+	    done / 2, t / 1000, t ? done * SECTOR * 1000 / t : 0, sd.mhz10 / 10, sd.mhz10 % 10, error);
+}
+
 static int
 nx_sdmmc_init(void)
 {
@@ -825,6 +986,7 @@ nx_sdmmc_init(void)
 	}
 	sd.first_block = first;
 	sd.nblocks = count;
+	sd_bench();
 
 	sd.bmajor = bdevsw_add(-1, &nx_sdmmc_bdevsw);
 	if (sd.bmajor < 0) {
-- 
2.56.0

